generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legalName           String?
  address             Json?    // { street, city, country, postalCode }
  taxId               String?
  logoUrl             String?
  defaultTaxRate      Float    @default(0)
  currency            String   @default("USD")
  onboardingCompleted Boolean  @default(false)

  users    User[]
  taxRules TaxRule[]
  expenses Expense[]
  invoices Invoice[]
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  clientName     String
  clientEmail    String
  clientAddress  Json?
  subtotal       Float
  totalTax       Float
  total          Float
  status         InvoiceStatus @default(DRAFT)
  pdfUrl         String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lineItems    InvoiceLineItem[]
  organization Organization      @relation(fields: [organizationId], references: [id])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float   @default(0)
  amount      Float
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model Expense {
  id             String        @id @default(cuid())
  date           DateTime
  description    String
  amount         Float
  category       String?
  taxRelevant    Boolean?
  status         ExpenseStatus @default(PENDING)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

enum ExpenseStatus {
  PENDING
  CATEGORIZED
  REVIEWED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model TaxRule {
  id             String   @id @default(cuid())
  name           String
  jurisdiction   String   // Country ISO or US State ISO
  rate           Float
  taxType        TaxType  @default(VAT)
  isNexus        Boolean  @default(false)
  appliesTo      String[] // product categories
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum TaxType {
  VAT
  SALES_TAX
  GST
}

enum Plan {
  FREE
  PRO
  SCALE
}

enum Role {
  ADMIN
  MEMBER
}
