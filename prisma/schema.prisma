generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legalName           String?
  address             Json?    // { street, city, country, postalCode }
  taxId               String?
  logoUrl             String?
  defaultTaxRate      Float    @default(0)
  currency            String   @default("USD")
  onboardingCompleted Boolean  @default(false)

  users    User[]
  taxRules TaxRule[]
  expenses Expense[]
  invoices Invoice[]
  anomalies ExpenseAnomaly[]
  webhooks  Webhook[]
  reportSchedules ReportSchedule[]
  transactions    Transaction[]
  contracts       Contract[]
  financialSnapshot FinancialSnapshot?
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  clientName     String
  clientEmail    String
  clientAddress  Json?
  subtotal       Float
  totalTax       Float
  total          Float
  status         InvoiceStatus @default(DRAFT)
  pdfUrl         String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lineItems    InvoiceLineItem[]
  organization Organization      @relation(fields: [organizationId], references: [id])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float   @default(0)
  amount      Float
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model Expense {
  id             String        @id @default(cuid())
  date           DateTime
  description    String
  amount         Float
  category       String?
  taxRelevant    Boolean?
  status         ExpenseStatus @default(PENDING)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  anomalies    ExpenseAnomaly[]
}

model ExpenseAnomaly {
  id             String      @id @default(cuid())
  type           AnomalyType
  description    String
  confidence     Float       @default(1.0)
  isFalsePositive Boolean     @default(false)
  status         AnomalyStatus @default(PENDING)
  expenseId      String
  organizationId String
  createdAt      DateTime    @default(now())

  expense      Expense      @relation(fields: [expenseId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

enum AnomalyType {
  DUPLICATE
  UNUSUAL_AMOUNT
  WEEKEND_EXPENSE
  UNUSUAL_CATEGORY
}

enum AnomalyStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ExpenseStatus {
  PENDING
  CATEGORIZED
  REVIEWED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  organizationId String
  role           Role     @default(MEMBER)
  reportPreferences Json?   // { receiveWeekly: boolean, reportTypes: string[] }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model TaxRule {
  id             String   @id @default(cuid())
  name           String
  jurisdiction   String   // Country ISO or US State ISO
  rate           Float
  taxType        TaxType  @default(VAT)
  isNexus        Boolean  @default(false)
  appliesTo      String[] // product categories
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum TaxType {
  VAT
  SALES_TAX
  GST
}

model Webhook {
  id             String      @id @default(cuid())
  url            String
  events         String[]    // ["invoice.paid", "expense.created"]
  secret         String
  lastSent       DateTime?
  failures       Int         @default(0)
  organizationId String
  createdAt      DateTime    @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  logs           WebhookLog[]
}

model WebhookLog {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  success      Boolean
  retryCount   Int      @default(0)
  createdAt    DateTime @default(now())

  webhook      Webhook  @relation(fields: [webhookId], references: [id])
}

model ReportSchedule {
  id             String      @id @default(cuid())
  type           ReportType
  frequency      Frequency
  recipients     String[]    // Emails
  lastSent       DateTime?
  organizationId String
  createdAt      DateTime    @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum ReportType {
  CASH_FLOW
  TAX_SUMMARY
  FULL_DIGEST
}

enum Frequency {
  WEEKLY
  MONTHLY
}

enum Plan {
  FREE
  PRO
  SCALE
}

enum Role {
  ADMIN
  MEMBER
}

model Transaction {
  id                     String      @id @default(cuid())
  stripePaymentIntentId  String      @unique
  amount                 Float
  currency               String      @default("usd")
  description            String?
  customerEmail          String?
  
  // R2R & O&M fields
  revenueRecognitionType String      @default("immediate") // immediate, deferred
  recognizedRevenue      Float?      // amount recognized now
  deferredRevenue        Float?      @default(0)
  
  // Auditor fields
  auditStatus            String      @default("pending") // pending, verified, failed
  auditHash              String?
  
  // FP&A fields
  runwayMonths           Float?
  zeroCashDate           DateTime?
  percentAhead           Float?      // % ahead of financial plan
  
  // Workflow state
  agentStatus            Json?        // stores logs per agent: { r2r: "done", om: "pending", ... }
  agentLogs              Json        // array of { agent, message, timestamp }
  workflowStatus         String      @default("pending") // pending, running, completed, error
  
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model Contract {
  id                    String   @id @default(cuid())
  stripePaymentIntentId String   @unique
  customerEmail         String
  amount                Float
  status                String   @default("signed") // signed, pending
  signedAt              DateTime @default(now())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
}

model FinancialSnapshot {
  id                    String   @id @default(cuid())
  bankBalance           Float
  averageMonthlyExpenses Float
  runwayMonths          Float
  zeroCashDate          DateTime
  updatedAt             DateTime @updatedAt
  organizationId        String   @unique
  organization          Organization @relation(fields: [organizationId], references: [id])
}
